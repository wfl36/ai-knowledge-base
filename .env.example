# AI知识库配置

# LLM API (OpenRouter)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=z-ai/glm-5.1
# LLM 分析并发数 (越大越快, 过大可能触发 API 限流)
LLM_CONCURRENCY=5

# GitHub (可选, 不设则用匿名请求)
GITHUB_TOKEN=

# 信息源 (逗号分隔, 可选: github,rss,hackernews)
AKB_SOURCES=github,rss,hackernews
# RSS/Atom 订阅源 (逗号分隔; 留空用默认: arXiv cs.AI/cs.CL + HuggingFace blog)
RSS_FEEDS=
RSS_MAX_PER_FEED=10
# Hacker News (Algolia API, 免鉴权)
HN_QUERY=AI OR LLM OR agent
HN_MIN_POINTS=50
HN_MAX_ITEMS=20

# 定时抓取
CRAWL_SCHEDULE=0 0 * * *

# FastAPI
API_HOST=127.0.0.1
API_PORT=8900

# 存储
KNOWLEDGE_DIR=./knowledge
